{
  "testTimeout": 5000,
  "rootDir": "../",
  "modulePaths": ["."],
  "testEnvironment": "node",
  "testMatch": ["<rootDir>/test/**/*.spec.ts"],
  "collectCoverage": true,
  "coverageDirectory": "coverage",
  "collectCoverageFrom": [
    "<rootDir>/src/{app,modules}/**/constants/**/*.constant.ts",
    "<rootDir>/src/{app,modules}/**/controllers/**/*.controller.ts",
    "<rootDir>/src/{app,modules}/**/decorators/**/*.decorator.ts",
    "<rootDir>/src/{app,modules}/**/dtos/**/*.dto.ts",
    "<rootDir>/src/{app,modules}/**/enums/**/*.enum.ts",
    "<rootDir>/src/{app,modules}/**/errors/**/*.error.ts",
    "<rootDir>/src/{app,modules}/**/events/**/*.event.ts",
    "<rootDir>/src/{app,modules}/**/exceptions/**/*.exception.ts",
    "<rootDir>/src/{app,modules}/**/filters/**/*.filter.ts",
    "<rootDir>/src/{app,modules}/**/guards/**/*.guard.ts",
    "<rootDir>/src/{app,modules}/**/helpers/**/*.*.ts",
    "<rootDir>/src/{app,modules}/**/indicators/**/*.indicator.ts",
    "<rootDir>/src/{app,modules}/**/interceptors/**/*.interceptor.ts",
    "<rootDir>/src/{app,modules}/**/interfaces/**/*.interface.ts",
    "<rootDir>/src/{app,modules}/**/listeners/**/*.listener.ts",
    "<rootDir>/src/{app,modules}/**/middleware/**/*.middleware.ts",
    "<rootDir>/src/{app,modules}/**/pipes/**/*.pipe.ts",
    "<rootDir>/src/{app,modules}/**/processors/**/*.processor.ts",
    "<rootDir>/src/{app,modules}/**/rules/**/*.rule.ts",
    "<rootDir>/src/{app,modules}/**/services/**/*.service.ts",
    "<rootDir>/src/{app,modules}/**/tasks/**/*.task.ts",
    "<rootDir>/src/{app,modules}/**/transforms/**/*.transform.ts",
    "<rootDir>/src/{app,modules}/**/validators/**/*.validator.ts"
  ],
  "coverageThreshold": {
    "global": {
      "branches": 100,
      "functions": 100,
      "lines": 100,
      "statements": 100
    }
  },
  "coverageReporters": ["html", "lcov", "json-summary"],
  "moduleFileExtensions": ["js", "ts", "json"],
  "coverageProvider": "v8",
  "transform": {
    "^.+\\.(t|j)sx?$": [
      "@swc/jest",
      {
        "sourceMaps": true
      }
    ]
  },
  "modulePathIgnorePatterns": ["<rootDir>/dist"]
}

{
  "name": "nestjs-boilerplate",
  "version": "0.0.1",
  "description": "Nestjs Boilerplate",
  "author": {
    "name": "Nam Dinh",
    "email": "namdwb@gmail.com"
  },
  "engines": {
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm",
    "node": ">= 22.18.0",
    "pnpm": ">= 10.25.0"
  },
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prepare": "husky",
    "preinstall": "npx only-allow pnpm",
    "prebuild": "rimraf dist && pnpm db:generate",
    "build": "nest build api cli",
    "bundle": "ncc build dist/main.js -m -o dist && mv dist/index.js dist/main.js",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"libs/**/*.ts\" --log-level warn",
    "deadcode": "ts-prune --project tsconfig.json --unusedInModule --skip *.json",
    "spell": "cspell lint --config cspell.json '{src,libs,test}/**/*.ts' --color --gitignore --no-must-find-files --no-summary --no-progress || true",
    "start:cli": "ts-node -r tsconfig-paths/register ./src/cli.ts",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:repl": "nest start --entryFile repl",
    "start:prod:app": "node dist/main",
    "start:prod:cli": "node dist/cli",
    "app:env:generate": "npx ts-node scripts/generate-env.ts",
    "app:keys:generate": "npx ts-node scripts/generate-keys.ts",
    "app:reset": "pnpm app:reset:file && pnpm app:reset:data",
    "app:reset:file": "rimraf logs/*/ public/uploads/*/ src/temporary/*/ logs/.nestjs_repl_history",
    "app:reset:data": "pnpm db:clear && pnpm start:cli seed:role && pnpm start:cli seed:permission && pnpm start:cli seed:user",
    "admin:install": "pnpm install --filter nest-admin",
    "admin:build": "pnpm --filter nest-admin schema:rebuild",
    "admin:migrate": "rm -rf public/admin && mv ./packages/nest-admin/dist public/admin",
    "schematics:install": "pnpm install --filter nest-schematics",
    "schematics:build": "pnpm --filter nest-schematics build",
    "schematics:generate": "pnpm --filter nest-schematics exec nest g -p modules res",
    "db:format": "npx prisma format",
    "db:studio": "npx prisma studio",
    "db:generate": "npx prisma generate",
    "db:clear": "npx prisma db push --force-reset",
    "db:reset": "npx prisma migrate reset --force",
    "db:migrate": "npx prisma migrate dev --create-only",
    "db:deploy": "npx prisma migrate deploy",
    "package:upgrade": "npx npm-check-updates -u",
    "package:check": "npx npm-check-updates -i",
    "lint": "pnpm lint:fix && pnpm lint:staged",
    "lint:staged": "lint-staged",
    "lint:fix": "eslint --fix",
    "test": "pnpm test:e2e && pnpm test:cov",
    "test:cov": "jest --coverage --passWithNoTests --forceExit",
    "test:e2e": "jest --config ./test/jest-e2e.json --passWithNoTests --forceExit",
    "test:watch": "jest --watch",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand"
  },
  "dependencies": {
    "@casl/ability": "6.7.5",
    "@casl/prisma": "1.6.0",
    "@keyv/redis": "5.1.5",
    "@nestjs/axios": "4.0.1",
    "@nestjs/bullmq": "11.0.4",
    "@nestjs/cache-manager": "3.1.0",
    "@nestjs/common": "11.1.12",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.12",
    "@nestjs/event-emitter": "3.0.1",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/mapped-types": "2.1.0",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.12",
    "@nestjs/platform-socket.io": "11.1.12",
    "@nestjs/schedule": "6.1.0",
    "@nestjs/serve-static": "5.0.4",
    "@nestjs/swagger": "11.2.5",
    "@nestjs/throttler": "6.5.0",
    "@nestjs/websockets": "11.1.12",
    "@onesignal/node-onesignal": "5.3.1-beta1",
    "@prisma/adapter-mariadb": "7.2.0",
    "@prisma/adapter-pg": "7.2.0",
    "@prisma/client": "7.2.0",
    "@types/multer": "2.0.0",
    "@types/uuid": "^11.0.0",
    "archiver": "7.0.1",
    "axios": "1.13.2",
    "bcrypt": "6.0.0",
    "body-parser": "^2.2.2",
    "bson-objectid": "^2.0.4",
    "bullmq": "5.66.5",
    "bytes": "^3.1.2",
    "cache-manager": "7.2.8",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.3",
    "compression": "1.8.1",
    "concat-stream": "^2.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "exceljs": "4.4.0",
    "ffmpeg-static": "5.3.0",
    "firebase-admin": "13.6.0",
    "fluent-ffmpeg": "2.1.3",
    "google-auth-library": "10.5.0",
    "hbs": "4.2.0",
    "heic-convert": "2.1.0",
    "helmet": "8.1.0",
    "image-size": "2.0.2",
    "jimp": "1.6.0",
    "keyv": "5.5.5",
    "lru-cache": "^11.2.4",
    "luxon": "3.7.2",
    "mime": "^3.0.0",
    "ms": "^2.1.3",
    "multer": "2.0.2",
    "nest-commander": "3.20.1",
    "nestjs-i18n": "10.6.0",
    "nodemailer": "7.0.12",
    "opossum": "9.0.0",
    "otplib": "^13.2.1",
    "p-queue": "^9.1.0",
    "p-retry": "^7.1.1",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pdfkit": "0.17.2",
    "pg": "8.17.1",
    "pino": "10.2.0",
    "pino-http": "11.0.0",
    "prom-client": "15.1.3",
    "randexp": "0.5.3",
    "range-parser": "1.2.1",
    "reflect-metadata": "0.2.2",
    "response-time": "2.3.4",
    "rimraf": "6.1.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.3",
    "twilio": "5.11.2",
    "ua-parser-js": "2.0.8",
    "uuid": "^11.1.0",
    "verify-apple-id-token": "3.1.2"
  },
  "devDependencies": {
    "@commitlint/cli": "20.3.1",
    "@commitlint/config-conventional": "20.3.1",
    "@nestjs/cli": "11.0.15",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.1.12",
    "@swc/core": "1.15.8",
    "@types/archiver": "7.0.0",
    "@types/bcrypt": "6.0.0",
    "@types/bytes": "3.1.5",
    "@types/compression": "1.8.1",
    "@types/concat-stream": "2.0.3",
    "@types/express": "5.0.6",
    "@types/fluent-ffmpeg": "2.1.28",
    "@types/heic-convert": "2.1.0",
    "@types/html-pdf": "3.0.3",
    "@types/jest": "30.0.0",
    "@types/luxon": "3.7.1",
    "@types/mime": "^3.0.4",
    "@types/morgan": "1.9.10",
    "@types/ms": "^2.1.0",
    "@types/node": "25.0.8",
    "@types/nodemailer": "7.0.5",
    "@types/opossum": "^8.1.9",
    "@types/p-queue": "^3.2.1",
    "@types/p-retry": "^3.0.1",
    "@types/passport-jwt": "4.0.1",
    "@types/pdfkit": "0.17.4",
    "@types/range-parser": "^1.2.7",
    "@types/response-time": "2.3.9",
    "@types/supertest": "6.0.3",
    "@types/ua-parser-js": "0.7.39",
    "@typescript-eslint/eslint-plugin": "8.53.0",
    "@typescript-eslint/parser": "8.53.0",
    "@vercel/ncc": "0.38.4",
    "cspell": "9.6.0",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "husky": "9.1.7",
    "jest": "30.2.0",
    "lint-staged": "16.2.7",
    "prettier": "3.8.0",
    "prisma": "7.2.0",
    "source-map-support": "0.5.21",
    "stop-only": "3.4.4",
    "supertest": "7.2.2",
    "swc-loader": "0.2.7",
    "ts-jest": "29.4.6",
    "ts-loader": "9.5.4",
    "ts-node": "10.9.2",
    "ts-prune": "0.10.3",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.53.0"
  },
  "lint-staged": {
    "**/*.ts": [
      "eslint",
      "stop-only --file"
    ],
    "*.{json,yaml}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@10.28.0",
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src/",
      "<rootDir>/libs/",
      "<rootDir>/test/"
    ],
    "moduleNameMapper": {
      "^@runtime/prisma-client": "<rootDir>/prisma/runtime/client",
      "^@runtime/prisma-browser": "<rootDir>/prisma/runtime/browser",
      "^lib/nest-auth(|/.*)$": "<rootDir>/libs/nest-auth/src/$1",
      "^lib/nest-core(|/.*)$": "<rootDir>/libs/nest-core/src/$1",
      "^lib/nest-web(|/.*)$": "<rootDir>/libs/nest-web/src/$1",
      "^lib/nest-prisma(|/.*)$": "<rootDir>/libs/nest-prisma/src/$1",
      "^src/(.*)$": "<rootDir>/../src/$1"
    }
  }
}

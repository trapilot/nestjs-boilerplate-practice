{
  "name": "nest-admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "/admin",
  "scripts": {
    "build": "tsc && vite build",
    "start:dev": "vite --port 4000",
    "schema:download": "cp -f ../../public/docs/swagger-admin.json swagger.json",
    "schema:generate": "npx openapi-typescript swagger.json -o ./src/types/api.d.ts",
    "schema:build": "node scripts/generateApi.mjs",
    "schema:rebuild": "pnpm schema:download && pnpm schema:generate && pnpm schema:build && pnpm build",
    "lint": "eslint",
    "lint:staged": "lint-staged",
    "lint:fix": "eslint --fix",
    "format": "prettier --write \"src/**/*.ts\"  \"src/**/*.tsx\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.28.9",
    "@tinymce/tinymce-react": "^6.3.0",
    "axios": "^1.6.8",
    "i18next": "^23.10.1",
    "i18next-browser-languagedetector": "^7.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^14.1.0",
    "react-router-dom": "^6.22.3"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "lint-staged": "^16.1.5",
    "openapi-typescript": "^7.9.1",
    "openapi-typescript-codegen": "^0.29.0",
    "prettier": "^3.6.2",
    "typescript": "^5.2.2",
    "vite": "^5.2.0"
  },
  "lint-staged": {
    "**/*.ts": [
      "prettier --write",
      "eslint",
      "stop-only --file",
      "git add ."
    ],
    "*.{json,yaml}": [
      "prettier --write"
    ]
  }
}
